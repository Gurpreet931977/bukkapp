# ==============================================================================
# BUKKAPP Environment Configuration
# Copy this file to .env.local and populate with your credentials
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Client SDK Configuration
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="bukkapp-prod.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="bukkapp-prod"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="bukkapp-prod.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK (Optional - for server-side auth verification in API routes)
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# PostgreSQL / Supabase Connection (Optional - when using direct SQL database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bukkapp"
DIRECT_URL="postgresql://postgres:password@localhost:5432/bukkapp"

# Master Admin Security Passkey
MASTER_ADMIN_SECRET="admin123"
