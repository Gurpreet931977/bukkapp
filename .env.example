# ==============================================================================
# BUKKAPP Environment Configuration (.env.local)
# Hybrid Architecture: Free Phone OTP (Firebase) + PostgreSQL Database (Supabase)
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Primary PostgreSQL Relational Database)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..." # Optional - for administrative backend operations

# Direct PostgreSQL Connection Strings (Optional - for Prisma, Drizzle, or psql)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. FIREBASE PHONE AUTH CONFIGURATION (Free 10,000 SMS OTPs/Month)
# Obtain from: Firebase Console -> Project Settings -> General -> Your Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="bukkapp-prod.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="bukkapp-prod"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="bukkapp-prod.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 3. MASTER OPERATIONS ADMIN PASSKEY
# ------------------------------------------------------------------------------
MASTER_ADMIN_SECRET="admin123"

# ------------------------------------------------------------------------------
# 4. CASHFREE PAYMENT GATEWAY (UPI, Cards, NetBanking)
# Obtain from: Cashfree Merchant Dashboard -> Payment Gateway -> Developers -> API Keys
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="TEST" # "TEST" for Sandbox or "PROD" for Live production
NEXT_PUBLIC_CASHFREE_ENV="sandbox" # "sandbox" or "production"
